# Production .env template.
# Copy to `.env` on the server, fill in the secrets, chmod 600.
# NEVER commit the filled .env.

APP_NAME="Malawi Adventist Music"
APP_ENV=production
APP_KEY=                                   # generate with: php artisan key:generate --show
APP_DEBUG=false
APP_URL=https://malawiadventistmusic.com
APP_TIMEZONE=Africa/Blantyre

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Docker service DNS names — do not change unless you rename services in compose.
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=malawiadventistmusic
DB_USERNAME=mam
DB_PASSWORD=                               # generate strong random
DB_ROOT_PASSWORD=                          # generate strong random

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=redis

CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail — pick one:
# 1) Postmark / Mailgun / Amazon SES — recommended for production deliverability
# 2) Fallback SMTP
MAIL_MAILER=smtp
MAIL_HOST=                                 # e.g. smtp.postmarkapp.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@malawiadventistmusic.com"
MAIL_FROM_NAME="${APP_NAME}"

# Object storage (Hetzner Storage Box or S3-compatible) — configure in a later phase
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-central-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=true
AWS_ENDPOINT=

VITE_APP_NAME="${APP_NAME}"

# PayChangu (production keys — DO NOT reuse the ones pasted in chat during dev; rotate first)
PAYCHANGU_BASE_URL=https://api.paychangu.com
PAYCHANGU_PUBLIC_KEY=
PAYCHANGU_SECRET_KEY=
PAYCHANGU_ENCRYPTION_KEY=
PAYCHANGU_CALLBACK_URL="${APP_URL}/payments/webhook/paychangu"
PAYCHANGU_RETURN_URL="${APP_URL}/payments/return"
PAYCHANGU_WEBHOOK_SECRET=
PAYCHANGU_FAKE=false

# Submission fee
SUBMISSION_FEE_AMOUNT=15000
SUBMISSION_FEE_CURRENCY=MWK
